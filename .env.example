# Copy this file to .env and edit as needed.

# Port the server listens on.
PORT=3000

# When set, the app runs in HTTPS mode: it only accepts requests whose
# Origin matches this exact address, marks session cookies Secure, and
# sends HTTPS-only response headers. Must be the exact public HTTPS
# address of the app, with no trailing path.
# Example: PUBLIC_ORIGIN=https://accounts.your-domain.com
PUBLIC_ORIGIN=

# Directory where the SQLite database and setup code are stored.
LEDGER_DATA_DIR=.data
